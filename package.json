{
  "name": "@rhythm-archive/bms-player",
  "version": "0.1.0",
  "description": "BMS rhythm game player engine with WebGL rendering, judgment system, and audio playback",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "import": "./dist/game/index.js",
      "require": "./dist/game/index.cjs"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js",
      "require": "./dist/audio/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.150.0",
    "@react-three/fiber": ">=8.0.0",
    "zustand": ">=4.0.0",
    "@rhythm-archive/bms-core": ">=0.1.0"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "@epic-web/invariant": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "@react-three/fiber": "^9.5.0",
    "@react-three/drei": "^9.0.0",
    "zustand": "^5.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@types/lodash": "^4.17.0",
    "@rhythm-archive/bms-core": "file:../bms-core"
  },
  "keywords": ["bms", "rhythm-game", "iidx", "three.js", "webgl", "game-engine"],
  "license": "MIT"
}
